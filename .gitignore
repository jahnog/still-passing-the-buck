# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/
.pytest_cache/

# Scratch / generated
tmp/

# Previous-vintage rotation backups written by data_io.rotate_existing() whenever a
# downloader overwrites a raw dest. Local rollback aids, not repository content.
# cleanup_raw_downloads.py keeps only the live dest plus the newest previous copy.
data/raw/**/*_[0-9].json
data/raw/**/*_[0-9][0-9].json
data/raw/**/*_[0-9].json.meta.json
data/raw/**/*_[0-9][0-9].json.meta.json
data/raw/**/*_[0-9].csv
data/raw/**/*_[0-9][0-9].csv
data/raw/**/*_[0-9].csv.meta.json
data/raw/**/*_[0-9][0-9].csv.meta.json
data/raw/**/*_[0-9].xls
data/raw/**/*_[0-9][0-9].xls
data/raw/**/*_[0-9].xls.meta.json
data/raw/**/*_[0-9][0-9].xls.meta.json
data/raw/**/*_[0-9].xlsx
data/raw/**/*_[0-9][0-9].xlsx
data/raw/**/*_[0-9].xlsx.meta.json
data/raw/**/*_[0-9][0-9].xlsx.meta.json
data/raw/**/*_[0-9].zip
data/raw/**/*_[0-9][0-9].zip
data/raw/**/*_[0-9].zip.meta.json
data/raw/**/*_[0-9][0-9].zip.meta.json
*.paper.pdf
paper/generated/
!paper/generated/
# the published PDF is the distributed artifact (linked from the README); keep it tracked
paper/output/*
!paper/output/still-passing-the-buck.pdf

# Editor / OS
.vscode/
.idea/
.DS_Store
*.dccache

# AI tooling
.claude/
.codex/
.cursor/
.gemini/
.opencode/

# Secrets (plaintext fallback only — prefer keyring)
.env
.env.local
.env.*.local
*.env
!.env.example
